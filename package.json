{
  "name": "math-atlas",
  "main": "expo-router/entry",
  "description": "A local-first university mathematics learning MVP built with Expo and TypeScript.",
  "license": "MIT",
  "version": "1.23.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "fast-xml-parser": "^5.11.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-mathjax-html-to-svg": "^1.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.cjs",
    "validate:study": "node scripts/validate-study.cjs",
    "validate:methods": "node scripts/validate-methods.cjs",
    "validate:papers": "node scripts/validate-papers.cjs",
    "validate:curriculum": "node scripts/validate-curriculum.cjs",
    "validate:textbooks": "node scripts/validate-textbooks.cjs",
    "validate:roadmap": "node scripts/validate-roadmap.cjs",
    "validate:expansion": "node scripts/validate-ten-versions.cjs && node scripts/validate-ten-calculus.cjs && node scripts/validate-ten-a.cjs && node scripts/validate-ten-b.cjs && node scripts/validate-ten-c.cjs",
    "validate:expansion:v112": "node scripts/validate-expansion-v112.cjs",
    "validate:expansion:v111": "node scripts/validate-expansion-v111.cjs",
    "validate:expansion:v110": "node scripts/validate-expansion-v110.cjs",
    "validate:expansion:v19": "node scripts/validate-expansion-v19.cjs",
    "test": "node scripts/validate-all.cjs",
    "validate:project": "node scripts/validate-project-links.cjs"
  }
}
