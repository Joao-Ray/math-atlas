{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM"],
    "types": ["node", "@tarojs/taro"],
    "baseUrl": ".",
    "paths": { "@/*": ["../*"] }
  },
  "include": ["src", "config", "../data", "../types"]
}
